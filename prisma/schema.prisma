// MemoVue data model.
//
// A ROLL is one shared, time-boxed photo collection. A guest is a browser: the signed cookie
// tied to a Guest row is the identity, and the name is only a caption. Hosts sign in with
// Google; there are no passwords anywhere in this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HOST
  ADMIN
}

enum RollStatus {
  ACTIVE
  ARCHIVED
}

enum RevealMode {
  /// Photos are legible as they are taken. Nothing is ever sealed.
  DURING
  /// Everything opens the moment the roll closes.
  AFTER
  /// Everything opens `revealDelayHours` after the roll closes.
  DELAY
}

enum PhotoStatus {
  PENDING
  READY
}

enum DeletedBy {
  /// The host pressed delete (or closed the account, which takes this row with it).
  HOST
  /// The nightly sweep, once `keptUntil` passed.
  EXPIRY
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// Google's stable `sub` claim. Nullable so a row can exist before its first sign-in.
  googleId  String? @unique
  avatarUrl String?

  role Role @default(HOST)

  /// Bumped by "sign out everywhere" so tokens already in the wild stop validating.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  rolls        Roll[]
  guests       Guest[]
  deletedRolls DeletedRoll[]
  redemptions  Redemption[]
}

model Roll {
  id     String @id @default(cuid())
  code   String @unique
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  name String

  /// R2 key for an uploaded cover. Null falls back to `coverPreset`.
  coverKey    String?
  coverPreset Int     @default(0)

  /// Bumped on each cover upload and appended as `?v=`, since `coverKey` is overwritten in
  /// place and the CDN would otherwise keep serving the old picture.
  coverVersion Int @default(0)

  /// The wedding business whose referral code created this roll; null for an individual's code.
  /// Written once, at creation, and never edited: the roll credits whoever sent the host here.
  referrerId String?
  referrer   Referrer? @relation(fields: [referrerId], references: [id], onDelete: SetNull)

  maxGuests      Int
  photosPerGuest Int

  /// false: a guest sees only their own frames; the host sees all.
  everyoneCanSee Boolean @default(true)

  /// Whether guests may hand their own film to the shots pool. Drawing from it is unaffected.
  giveawayAllowed Boolean @default(false)

  /// Whether guests may add photos from their library. Also keeps the roll taking photos past
  /// its close, until it is deleted. See `acceptsUploads`.
  uploadsAllowed Boolean @default(false)

  /// Capture runs startsAt..finishesAt. The reveal is a separate moment.
  startsAt   DateTime
  finishesAt DateTime

  /// When the first frame was reserved. Starts the shots pool's clock. Written once.
  firstShotAt DateTime?

  revealMode       RevealMode @default(AFTER)
  revealDelayHours Int        @default(0)

  /// Derived from finishesAt + mode + delay on every write, never accepted from input.
  /// Stored so jobs can query it.
  revealAt      DateTime
  revealedEarly Boolean  @default(false)

  /// Lifetime count of ZIP downloads, against the ceiling in `constants.ts`.
  downloads Int @default(0)

  /// First time anybody loaded this roll's album after it opened. Written once.
  albumOpenedAt DateTime?

  status RollStatus @default(ACTIVE)

  /// finishesAt + 30 days. What the deletion job reads.
  keptUntil DateTime
  /// Set when the host has been warned that deletion is coming.
  warnedAt  DateTime?

  createdAt DateTime @default(now())

  guests Guest[]
  photos Photo[]

  @@index([hostId])
  @@index([keptUntil])
  @@index([referrerId])
}

model Guest {
  id     String @id @default(cuid())
  rollId String
  roll   Roll   @relation(fields: [rollId], references: [id], onDelete: Cascade)

  /// A label, not an identifier. Duplicate names in one roll are fine.
  name String

  /// Set if the guest has an account, so the roll reaches their own home screen.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Net shots moved from the shared pool: positive drawn, negative given. Their allowance is
  /// `photosPerGuest + fromPool`; the pool itself is derived (see `poolFrom`).
  fromPool Int @default(0)

  /// How many times this guest has drawn from the pool. Giving and reclaiming do not count.
  /// See `refillsLeft`.
  refills Int @default(0)

  createdAt DateTime @default(now())

  photos Photo[]

  /// One row per account per roll. Nulls do not collide, so anonymous guests are unconstrained.
  @@unique([rollId, userId])
  @@index([rollId])
  @@index([userId])
}

model Photo {
  id      String @id @default(cuid())
  rollId  String
  roll    Roll   @relation(fields: [rollId], references: [id], onDelete: Cascade)
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  fullKey    String
  previewKey String
  /// Tiny base64 JPEG (~32px wide) inlined so the sealed wall needs zero fetches.
  blurData String @db.Text

  width  Int
  height Int
  bytes  Int

  /// PENDING once upload URLs are issued, READY once the client confirms. Both count against
  /// quota; everything shown counts READY only. Abandoned PENDING rows are swept after a week.
  status PhotoStatus @default(PENDING)

  /// The phone's own name for the frame, so a reservation asked for twice is one reservation.
  clientId String?

  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  /// Every hot read is one roll's READY frames, newest first, and the count is index-only.
  @@index([rollId, status, takenAt])
  /// Also every per-guest count, which leads with `guestId`.
  @@unique([guestId, clientId])
  @@index([status, createdAt])
}

/// What a deleted roll leaves behind: settings and counts only, no photos or guest names.
/// Goes when the host's account does.
model DeletedRoll {
  /// The roll's own id.
  id     String @id
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  deletedBy DeletedBy
  /// The roll's, carried over. What `/rolls` sorts hosts by.
  createdAt DateTime
  deletedAt DateTime @default(now())

  /// `describeRoll` as it read the moment before deletion, guests unnamed.
  summary String @db.Text

  @@index([hostId])
}

enum CodeKind {
  /// One roll, for one person. Never shown to anybody.
  INDIVIDUAL
  /// A wedding business: `maxUses` rolls, each carrying its card.
  BUSINESS
}

/// A referral code. Every roll is created with one, typed at the wizard's Create button.
///
/// A business's code also carries the business onto the home screen of every roll it creates,
/// where the guests looking at the album see it. The card fields below are a business's alone.
/// Discounts, if rolls ever start costing money, belong on this row.
model Referrer {
  id String @id @default(cuid())

  /// What the host types, held in the same normalised form a roll code is (see `codes.ts`).
  code String @unique

  kind CodeKind @default(BUSINESS)

  /// Rolls this code may create. Always 1 for an individual.
  maxUses Int @default(1)
  /// Rolls it has created. Never given back, so deleting a roll does not refund its code.
  used    Int @default(0)

  /// The business, as it reads on the roll screen and in every Telegram message about the roll.
  /// Null for an individual's code, which is known by its `email`.
  name String?

  /// Where the card links. Null renders the name without a link.
  url String?

  /// Where the code is emailed when an admin sends it. A business is also told here every time
  /// a roll is created with its code. Null for a code not given to anybody yet, or a business
  /// that would rather just see its name on the album.
  email String?

  /// A logo the card shows beside the name, hosted by them rather than by us. A dead link hides
  /// itself instead of breaking the card.
  logoUrl String?

  createdAt DateTime @default(now())

  /// Business codes only: the rolls wearing this card.
  rolls       Roll[]
  redemptions Redemption[]
}

/// One roll created with one code, under the name it had then. The admin's record of who used
/// what; `Referrer.used` is what refuses a spent code.
model Redemption {
  id         String   @id @default(cuid())
  referrerId String
  referrer   Referrer @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollName   String
  createdAt  DateTime @default(now())

  @@index([referrerId])
  @@index([userId])
}

/// Somebody asking for a referral code. Stored as well as emailed, because email is best-effort.
model CodeRequest {
  id String @id @default(cuid())

  /// Where the code goes. The account's, or typed by somebody without one.
  email String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A day's tally of things that leave no row of their own. No identifiers; nothing joins to it.
model Metric {
  /// The Kolkata wall-clock day as `YYYY-MM-DD`, as text so no driver can shift it.
  day   String
  name  String
  count Int      @default(0)

  @@id([day, name])
}

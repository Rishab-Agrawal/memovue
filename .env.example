# Copy to .env.local for development. Never commit a filled-in copy.

# Postgres. Locally this is Railway's TCP proxy URL; in production it's the private URL.
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Signs host and guest session cookies. Any long random string.
# Changing it signs everybody out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Public origin, no trailing slash. Used for QR codes and join links, so it must match
# what guests actually load or every printed code will point at the wrong host.
APP_URL="http://localhost:3000"

# This email is promoted to ADMIN automatically when it signs up, so nobody has to edit
# the database by hand to reach the beta approvals queue.
ADMIN_EMAIL=""

# Cloudflare R2. Dev and production share a bucket but are separated by key prefix.
# After changing APP_URL, re-run `npm run setup:r2` so browser uploads stay allowed.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="memovue"
# The Cloudflare custom domain in front of the bucket, no trailing slash. Every image in
# the app is served from here so the edge can cache it — without this the app refuses to
# treat R2 as configured at all, rather than silently falling back to per-request signed
# URLs that nothing can cache. Add it under R2 -> the bucket -> Settings -> Custom Domains.
R2_PUBLIC_URL="https://img.memovue.com"

# Google sign-in. Create an OAuth client of type "Web application" in Google Cloud Console
# and register {APP_URL}/api/auth/google/callback as an authorized redirect URI — it has to
# match character for character, so localhost and production each need their own entry.
# The ID is public; the secret is not.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Without it the app still works end to end and emails are logged instead of
# sent.
RESEND_API_KEY=""
EMAIL_FROM="MemoVue <hello@memovue.com>"

# Optional, and both or neither. Where beta access requests are pushed, because email to
# yourself is the one notification channel with nobody watching whether it arrived.
# Make a bot with @BotFather (/newbot) for the token, send your new bot /start so it is
# allowed to message you, then read the chat id out of:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

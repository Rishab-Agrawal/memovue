{
  "name": "memovue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup:r2": "tsx scripts/setup-r2.ts",
    "verify:guest-link": "tsx --conditions=react-server scripts/verify-guest-link.ts",
    "cleanup:test": "tsx scripts/cleanup-test-data.ts",
    "images": "tsx scripts/optimize-images.ts",
    "sweep": "tsx --conditions=react-server scripts/sweep-retention.ts",
    "backup": "tsx --conditions=react-server scripts/backup-db.ts",
    "digest": "tsx --conditions=react-server scripts/digest.ts",
    "restore": "tsx --conditions=react-server scripts/restore-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "jose": "^6.2.6",
    "jsqr": "^1.4.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...except the template, which holds no secrets and is the only place the required
# configuration is written down. Without this line a fresh clone gets no .env.example at all.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/test-results/
/playwright-report/
/blob-report/
/.playwright-mcp/
*.log

# local screenshots
/*.png


/shots/
/shots-guest/
/shots-reveal/

# agent tooling and design references kept in the working copy, not part of the product
/.agents/
/.claude/
/skills-lock.json
/uiux-reference/

# Playwright session state, minted per run by tests/global-setup.ts
tests/.auth/

# Instagram slides, regenerated by `node marketing/shoot.mjs` from carousel.html
/marketing/out/
